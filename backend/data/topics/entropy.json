  "quiz": [
    {
      "item_id": "fc1",
      "q": "Entropy measures what in a system?",
      "options": [
        "Total energy",
        "Degree of disorder",
        "Temperature"
      ],
      "correct": 1,
      "explain": "Entropy quantifies the randomness or disorder in a system."
    },
    {
      "item_id": "fc2",
      "q": "What law states entropy always increases in a closed system?",
      "options": [
        "Zeroth Law of Thermodynamics",
        "First Law of Thermodynamics",
        "Second Law of Thermodynamics"
      ],
      "correct": 2,
      "explain": "The Second Law says entropy in an isolated system never decreases."
    },
    {
      "item_id": "fc3",
      "q": "Melting increases what in a system?",
      "options": [
        "Potential energy",
        "Entropy",
