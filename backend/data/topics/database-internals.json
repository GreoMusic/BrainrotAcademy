  "quiz": [
    {
      "item_id": "fc1",
      "q": "What’s the time complexity of a B-tree search?",
      "options": [
        "O(1)",
        "O(log n)",
        "O(n)"
      ],
      "correct": 1,
      "explain": "B-trees are balanced, so searching is O(log n)."
    },
    {
      "item_id": "fc2",
      "q": "Where are all keys stored in a B+ tree?",
      "options": [
        "Internal nodes",
        "Leaf nodes",
        "Both nodes"
      ],
      "correct": 1,
      "explain": "B+ trees store all keys in leaf nodes for efficient range scans."
    },
    {
      "item_id": "fc3",
      "q": "Which data structure is commonly used for indexing?",
      "options": [
        "Hash table",
        "Linked list",
        "B-tree"
      ],
      "correct": 2,
      "explain": "B-trees are often used for indexes due to their balance and efficiency."
    },
    {
      "item_id": "fc4",
      "q": "What does WAL prevent?",
      "options": [
        "Data loss",
        "Slow queries",
        "Deadlocks"
      ],
      "correct": 0,
      "explain": "WAL logs changes before they’re written to disk, preventing data loss on crashes."
    },
    {
      "item_id": "fc5",
      "q": "Which ACID property ensures transactions don’t interfere?",
      "options": [
        "Atomicity",
        "Isolation",
        "Durability"
      ],
      "correct": 1,
      "explain": "Isolation prevents concurrent transactions from interfering with each other."
    },
    {
      "item_id": "fc6",
      "q": "What’s stored in a database buffer pool?",
      "options": [
        "Index files",
        "Frequently accessed pages",
        "User queries"
      ],
      "correct": 1,
      "explain": "Buffer pools cache frequently accessed data pages to reduce disk I/O."
    },
    {
      "item_id": "ff1",
      "q": "What does MVCC do in PostgreSQL?",
      "options": [
        "Prevents deadlocks",
        "Avoids locks",
        "Boosts speed"
      ],
      "correct": 1,
      "explain": "MVCC allows concurrent reads and writes without locking, improving performance."
    },
    {
