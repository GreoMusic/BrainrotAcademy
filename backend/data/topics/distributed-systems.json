  "quiz": [
    {
      "item_id": "fc1",
      "q": "Which is NOT a typical distributed system challenge?",
      "options": [
        "Latency",
        "Partial failures",
        "Single-threaded performance"
      ],
      "correct": 2,
      "explain": "Distributed systems deal with network delays and partial failures, not single-threaded speed."
    },
    {
      "item_id": "fc2",
      "q": "If you prioritize Consistency and Partition tolerance, what do you sacrifice?",
      "options": [
        "Availability",
        "Durability",
        "Scalability"
      ],
      "correct": 0,
      "explain": "CAP theorem: you can only guarantee two out of Consistency, Availability, Partition tolerance."
    },
    {
      "item_id": "fc3",
      "q": "Why do we use quorums?",
      "options": [
        "To reduce latency",
        "To ensure majority agreement",
        "To encrypt data"
