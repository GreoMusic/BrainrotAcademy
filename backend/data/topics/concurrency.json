  "quiz": [
    {
      "item_id": "fc1",
      "q": "Which of these is true about threads?",
      "options": [
        "They run in separate memory spaces",
        "They share the same memory",
        "They can’t communicate"
      ],
      "correct": 1,
      "explain": "Threads in the same process share memory, unlike processes."
    },
    {
      "item_id": "fc2",
      "q": "A mutex ensures what?",
      "options": [
        "Only one thread runs at a time",
        "Only one thread accesses shared data at a time",
        "Threads run in parallel"
      ],
      "correct": 1,
      "explain": "Mutexes prevent concurrent access to shared resources."
    },
    {
      "item_id": "fc3",
      "q": "Deadlock requires what four conditions?",
      "options": [
        "Mutual exclusion, hold and wait, no preemption, circular wait",
        "Starvation, race conditions, memory leaks",
        "Locks, semaphores, threads"
      ],
      "correct": 0,
      "explain": "These four conditions must all be true for a deadlock to occur."
    },
    {
